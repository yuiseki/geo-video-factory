{
  "name": "@geo-video-factory/renderer",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "geo-video-render": "./dist/src/render.js"
  },
  "scripts": {
    "build": "tsc && npm run bundle:page",
    "bundle:page": "esbuild src/page/flyover.ts --bundle --format=esm --platform=browser --target=es2022 --sourcemap --outfile=dist/src/page/flyover.js && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs dist/src/page/maplibre-gl-worker.mjs",
    "typecheck": "tsc --noEmit",
    "render": "node dist/src/render.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "test:coverage": "npm run build && node --experimental-test-coverage --test-skip-pattern=E2E --test-coverage-lines=65 --test-coverage-branches=80 --test-coverage-functions=90 --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "maplibre-gl": "6.18.0",
    "playwright": "1.64.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0"
  }
}

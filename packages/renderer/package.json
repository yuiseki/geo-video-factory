{
  "name": "@geo-video-factory/renderer",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "geo-video-render": "./dist/src/render.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "render": "node dist/src/render.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "test:coverage": "npm run build && node --experimental-test-coverage --test-coverage-lines=65 --test-coverage-branches=80 --test-coverage-functions=90 --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "maplibre-gl": "6.4.1",
    "playwright": "1.64.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
